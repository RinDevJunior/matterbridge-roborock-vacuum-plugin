{
	"mcpServers": {
		"codegraph": {
			"type": "stdio",
			"command": "codegraph",
			"args": ["serve", "--mcp"]
		},
		"glob-grep": {
			"type": "stdio",
			"command": "node",
			"args": [".claude/tools/glob-grep-server.cjs"]
		},
		"cli-runner": {
			"type": "stdio",
			"command": "node",
			"args": [".claude/tools/cli-runner-server.cjs"]
		},
		"read-log": {
			"type": "stdio",
			"command": "node",
			"args": [".claude/tools/read-log-server.cjs"]
		},
		"serena": {
			"type": "stdio",
			"command": "serena",
			"args": [
				"start-mcp-server",
				"--context",
				"ide",
				"--project",
				"/Volumes/ExternalSSD/code/matterbridge-roborock-vacuum-plugin"
			]
		}
	}
}
